# FTP connection
# ftp-deploy speaks plain FTP only (no FTPS/TLS). If your host requires
# encrypted FTP, this script needs to be ported to `basic-ftp` instead.
FTP_HOST=ftp.example.com
FTP_USER=your-username
FTP_PASSWORD=your-password
FTP_PORT=21

# Folder to upload, relative to this file's directory
LOCAL_DIR=public

# Destination folder on the server (absolute path)
REMOTE_ROOT=/www

# Optional extra exclude globs, comma-separated
# Examples: *.map, private/**, Thumbs.db
EXCLUDE=

# --- Setup ---
# Windows:  copy example.env .env
# macOS/Linux:  cp example.env .env
# Then fill in the values above. Never commit .env.
